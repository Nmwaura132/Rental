<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer (Android 13+). The launcher flattens this to a single tint,
  which is what makes it tricky: the two halves overlap at the tenon, so filling
  them as two separate paths merges them into one shapeless mass with no visible
  joint.

  Drawing both subpaths as ONE path with evenOdd instead turns their overlap
  into a hole, so the interlock is exactly what survives the tint — the joint
  reads as a gap rather than relying on colour that the launcher strips away.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#000000">
    <group
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateX="16.56"
        android:translateY="18.0">
        <path
            android:fillType="evenOdd"
            android:fillColor="#000000"
            android:pathData="M34,6 L48,14 L48,42 L60,42 L60,58 L48,58 L48,94 L10,94 L10,40 Z M70,6 L94,40 L94,94 L64,94 L64,64 L52,64 L52,36 L64,36 L56,14 Z" />
    </group>
</vector>
