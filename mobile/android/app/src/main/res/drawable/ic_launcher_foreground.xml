<?xml version="1.0" encoding="utf-8"?>
<!--
  Kasa mark — "Tenant Link": two half-dwellings interlocking on a shared tenon.

  Artwork is authored in a 100x100 space (content spans x 10..94, y 6..94) and
  placed into the 108dp adaptive-icon viewport at 0.72, which lands it well
  inside the 72dp safe zone. It is deliberately not scaled to fill that zone:
  the silhouette has a flat filled base, so pushing it to the edge leaves the
  corners crowding a circular mask with no optical margin.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateX="16.56"
        android:translateY="18.0">
        <path
            android:pathData="M34,6 L48,14 L48,42 L60,42 L60,58 L48,58 L48,94 L10,94 L10,40 Z"
            android:fillColor="#5868E0"
            android:strokeColor="#1A1A1F"
            android:strokeWidth="3"
            android:strokeLineJoin="miter" />
        <path
            android:pathData="M56,18 L94,40 L94,94 L64,94 L64,64 L52,64 L52,36 L64,36 L64,28 Z"
            android:fillColor="#FF7A66"
            android:strokeColor="#1A1A1F"
            android:strokeWidth="3"
            android:strokeLineJoin="miter" />
    </group>
</vector>
