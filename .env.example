# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-50-chars-minimum
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_NAME=rental_db
DB_USER=rental_user
DB_PASSWORD=strong-db-password-here
DB_ROOT_PASSWORD=strong-root-password-here
DB_HOST=db
DB_PORT=3306

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=strong-redis-password-here
REDIS_URL=redis://:strong-redis-password-here@redis:6379/0
CELERY_BROKER_URL=redis://:strong-redis-password-here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:strong-redis-password-here@redis:6379/1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── M-Pesa Daraja (Safaricom) ─────────────────────────────────────────────────
#
# SANDBOX SETUP (one-time):
#   1. Register at https://developer.safaricom.co.ke
#   2. Create an App — you'll receive Consumer Key + Consumer Secret
#   3. Get test credentials at https://developer.safaricom.co.ke/test_credentials
#      Sandbox shortcode: 174379
#      Sandbox passkey:   bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
#   4. Start ngrok (or any tunnel) and paste the HTTPS URL below
#   5. Run: docker compose exec api python manage.py register_mpesa_c2b
#
# PRODUCTION:
#   - MPESA_ENVIRONMENT=production
#   - Use your live Paybill shortcode + passkey from Safaricom Business
#   - MPESA_CALLBACK_URL must be a public HTTPS URL (not ngrok)
#
# NOTE: MPESA_CALLBACK_URL is the BASE path — do NOT include confirm/ or validate/.
#       The app automatically appends those suffixes when registering with Daraja.
#
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_ENVIRONMENT=sandbox
# Replace with your ngrok HTTPS URL (tunnel to port 8000):
MPESA_CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/v1/payments/mpesa/
MPESA_STK_CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/v1/payments/stk/callback/

# ── Africa's Talking (SMS / WhatsApp) ─────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_TEST_PHONE=

# Development seed accounts (required only by seed_dev_data)
DEV_LANDLORD_PHONE=
DEV_LANDLORD_PASSWORD=
DEV_TENANT_PHONE=
DEV_TENANT_PASSWORD=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@rentalmanager.co.ke

# ── Firebase (FCM push notifications) ────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=

# ── KCB Buni Bank IPN ────────────────────────────────────────────────────────
#
# SETUP:
#   1. Register at https://sandbox.buni.kcbgroup.com
#   2. Fill the IPN onboarding form and email buni@kcbgroup.com
#   3. Register your callback URL: /api/v1/payments/bank/kcb/ipn/
#   4. KCB will share the shared secret for HMAC-SHA256 signature verification
#
# IPN payload mirrors Daraja C2B Confirm — tenant must enter invoice number
# or unit number as BillRefNumber when doing a bank transfer.
#
KCB_IPN_SECRET=           # shared secret from KCB — leave blank in sandbox (skips verification)

# ── Equity Jenga Bank API ─────────────────────────────────────────────────────
#
# SETUP:
#   1. Register at https://developer.jengahq.io
#   2. Create a merchant → get API Key (username) + API Secret (password)
#   3. Generate an RSA key pair; upload public key to JengaHQ portal
#   4. Register IPN callback URL: /api/v1/payments/bank/equity/ipn/
#      with Basic Auth credentials (JENGA_IPN_USERNAME / JENGA_IPN_PASSWORD)
#   5. Note your Equity account number for statement polling
#
# Sandbox base URL: https://uat.jengahq.io
# Production base URL: https://api.jengahq.io
#
JENGA_BASE_URL=https://uat.jengahq.io
JENGA_API_KEY=            # Jenga merchant code / username
JENGA_API_SECRET=         # Jenga API secret / password
JENGA_PRIVATE_KEY=        # PEM RSA private key (single line, \n-escaped) for request signing
JENGA_ACCOUNT_NUMBER=     # Equity account number to monitor via statement polling
JENGA_COUNTRY_CODE=KE
JENGA_CURRENCY_CODE=KES
JENGA_IPN_USERNAME=       # Basic Auth username Jenga will call your IPN with
JENGA_IPN_PASSWORD=       # Basic Auth password Jenga will call your IPN with

# ── MinIO / S3 Storage ────────────────────────────────────────────────────────
MINIO_ROOT_USER=replace-with-random-access-key
MINIO_ROOT_PASSWORD=replace-with-random-secret-key
MINIO_BUCKET_NAME=rental-assets
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/rental-assets
S3_USE_SSL=False
S3_SIGNED_URL_EXPIRES=3600
